[alias]
  br = branch
  ci = commit --verbose
  co = checkout
  cp = cherry-pick
  fixup = "commit --fixup"
  lol = "log --graph --decorate --oneline"
  lola = "log --graph --decorate --oneline --all"
  s = status --short --branch
  squash = "commit --squash"
  st = status
  sta = stash
  unstage = "reset HEAD"

[pull]
  rebase = true
[credential "https://github.com"]
    helper =
    # Resolved from PATH: Homebrew installs gh outside /usr/bin.
    helper = !gh auth git-credential
[init]
    defaultBranch = main
